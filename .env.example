# Copie este arquivo para ".env" e ajuste o que precisar.
# Sem nenhum ".env" o projeto roda localmente com os valores padrão.

# Endereço público do site (usado em links de e-mail, no retorno do pagamento e nos metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail de atendimento que aparece no site e nos e-mails
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------- Banco de dados
#  - Local:    file:./data/app.db   (SQLite, criado automaticamente)
#  - Produção: libsql://SEU-BANCO.turso.io  (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Conta de administrador criada pelo "npm run db:seed".
# Em produção, defina uma senha forte ANTES de rodar o seed.
ADMIN_EMAIL=admin@vendra.test
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Pagamentos (Cakto)
# A venda acontece na Cakto e ela avisa a plataforma por webhook, que libera o plano.
# A chave secreta aparece ao cadastrar o webhook na Cakto (URL: https://seudominio.com.br/api/webhooks/cakto).
# Com ela preenchida, o botão "Pagar" leva para a Cakto (cadastre o link de cada plano em Admin > Planos).
CAKTO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Pagamentos (Hotmart, opcional)
# Desligada. Para religar (ex.: usar a rede de afiliados da Hotmart), preencha o "hottok"
# (Hotmart > Ferramentas > Webhook > Autenticação) e use links pay.hotmart.com nos planos.
HOTMART_HOTTOK=
# ID numérico do produto na Hotmart, se o webhook dela valer para a conta inteira.
HOTMART_PRODUCT_ID=

# Checkout de demonstração (ativa o plano sem cobrar de verdade).
# Fica ligado sozinho em desenvolvimento quando não há plataforma de pagamento configurada.
# Em produção só liga com "true" — não use quando estiver vendendo.
ALLOW_DEMO_CHECKOUT=

# ---------------------------------------------------------------- E-mails (Resend)
# Com a chave preenchida, os e-mails são enviados de verdade: boas-vindas, senha,
# pagamento confirmado e aviso de fim do acesso. Crie em https://resend.com
RESEND_API_KEY=

# Remetente dos e-mails, com um domínio verificado no Resend.
# Exemplo: Vendra <contato@seudominio.com.br>
EMAIL_FROM=

# ---------------------------------------------------------------- Rotina diária
# Senha da rota /api/cron/diario (avisos de fim de acesso e conferência de pagamentos).
# Use um texto longo e aleatório. Na Vercel, basta definir esta variável: o vercel.json já agenda a rotina.
CRON_SECRET=
